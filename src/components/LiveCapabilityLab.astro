<section class="live-lab" id="live-experiment" aria-labelledby="live-title">
  <header class="live-head">
    <span>04 / LIVE EXPERIMENT</span>
    <div>
      <p class="eyebrow">Capability Evolution Lab · Experiment 02</p>
      <h2 id="live-title">Give C Lab a problem.<br />Watch the method work.</h2>
      <p class="intro">Write a real problem in plain language. The same problem will go through a quick AI answer and a more structured C Lab process.</p>
    </div>
  </header>

  <div class="live-shell" data-live-wrapper data-app-url="https://script.google.com/macros/s/AKfycbwjxa81lNy4aY1ATp767p8x7SXLdymtlbvgOlhyoeYa3uUrDqIivU6253kxkGmM38ybmw/exec">
    <div class="pending" data-live-pending>
      <span>GOOGLE LIVE ENGINE</span>
      <h3>Secure live connection is being verified.</h3>
      <p>The interface is wired to the Google Apps Script endpoint, but production stays fail-closed until the deployed script passes a real Gemini smoke test.</p>
    </div>
    <iframe data-live-frame title="Capability Evolution Lab live experiment" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" hidden></iframe>
  </div>

  <p class="privacy-note">The LIVE experiment is isolated from the static public site. The Gemini credential stays server-side in Google Apps Script and is never shipped to GitHub Pages.</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-live-wrapper]').forEach((root) => {
    const appUrl = root.dataset.appUrl || '';
    const frame = root.querySelector<HTMLIFrameElement>('[data-live-frame]');
    const pending = root.querySelector<HTMLElement>('[data-live-pending]');
    const valid = /^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec(?:\?.*)?$/.test(appUrl);
    const localPreview = ['localhost', '127.0.0.1'].includes(window.location.hostname);
    if (valid && frame && !localPreview) {
      frame.src = appUrl;
      frame.hidden = false;
      if (pending) pending.hidden = true;
    }
  });

  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://script.google.com' && !event.origin.endsWith('.googleusercontent.com')) return;
    const data = event.data as { type?: string; height?: number };
    if (data?.type !== 'caplab-live-height' || !Number.isFinite(data.height)) return;
    const height = Math.max(680, Math.min(2600, Number(data.height)));
    document.querySelectorAll<HTMLIFrameElement>('[data-live-frame]').forEach((frame) => {
      if (event.source === frame.contentWindow) frame.style.height = `${height}px`;
    });
  });
</script>

