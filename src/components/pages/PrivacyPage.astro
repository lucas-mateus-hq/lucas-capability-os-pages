---
import LanguageSwitcher from '../LanguageSwitcher.astro';
import {privacyCopy} from '../../i18n/privacy';
interface Props {lang?: 'pt-BR'|'en-US'}
const {lang='en-US'}=Astro.props;
const en=lang==='en-US';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const pt=`${base}/privacidade/`;
const english=`${base}/privacy/`;
const canonical=new URL(en?english:pt,Astro.site).href;
const portfolio=`${base}/portfolio/${en?'':'pt/'}`;
const t=(key:string):string=>{if(en)return key;const value=privacyCopy[key];if(value===undefined)throw new Error('Missing translation: '+key);return value;};
const updated=en?'September 15, 2026':'15 de setembro de 2026';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={t("Privacy policy for Lucas Mateus's personal LinkedIn publishing integration.")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(pt,Astro.site).href} />
    <link rel="alternate" hreflang="en-US" href={new URL(english,Astro.site).href} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <title>{t("Privacy Policy — Lucas Mateus")}</title>
    <style>
      :root { font-family: "Source Sans 3", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #f3efe6; background: #263641; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      .privacy-languages{width:min(760px,calc(100% - 40px));margin:0 auto;display:flex;justify-content:flex-end;padding-top:20px}
      main { width: min(760px, calc(100% - 40px)); margin: 0 auto; padding: 28px 0 96px; }
      a { color: inherit; }
      .back { display: inline-block; margin-bottom: 48px; font-size: .92rem; }
      .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; }
      h1 { font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: .98; letter-spacing: -.045em; margin: 12px 0 20px; }
      .lead { font-size: 1.16rem; line-height: 1.65; max-width: 680px; }
      .updated { margin: 28px 0 52px; font-size: .9rem; opacity: .7; }
      section { border-top: 1px solid #53646b; padding: 28px 0; }
      h2 { margin: 0 0 12px; font-size: 1.15rem; }
      p { font-size: 18px; line-height: 1.7; margin: 0; max-width: 62ch; }
    </style>
  </head>
  <body>
    <header class="privacy-languages"><LanguageSwitcher lang={lang} pt={pt} en={english} /></header>
    <main>
      <a class="back" href={portfolio}>{t("← Professional portfolio")}</a>
      <p class="eyebrow">{t("Lucas Mateus · Privacy")}</p>
      <h1>{t("Privacy Policy")}</h1>
      <p class="lead">{t("This policy describes the limited data handling associated with Lucas Mateus's personal professional publishing workflow and its authorized LinkedIn integration.")}</p>
      <p class="updated"><strong>{t("Last updated:")}</strong> {updated}</p>

      <section><h2>{t("Purpose")}</h2><p>{t("The integration is a private publishing workflow used to distribute Lucas Mateus's own approved professional content to his personal LinkedIn presence. It is not offered as a public application or service to other users.")}</p></section>
      <section><h2>{t("Information processed")}</h2><p>{t("The workflow processes only information required to authenticate the authorized LinkedIn account and publish approved content. This may include LinkedIn authorization credentials, the account identifier required by the API, publication text, links and media metadata.")}</p></section>
      <section><h2>{t("Credentials and storage")}</h2><p>{t("Access tokens and authentication secrets are not embedded in this public website or intentionally exposed in public source content. Credentials used by the workflow are stored in restricted secret storage and used only for authorized publishing operations.")}</p></section>
      <section><h2>{t("Use and sharing")}</h2><p>{t("Information obtained through LinkedIn authorization is used only to operate the personal publishing integration. It is not sold, used for advertising, used to build third-party profiles, or intentionally shared with unrelated third parties. LinkedIn and infrastructure providers process information under their own applicable terms and privacy practices.")}</p></section>
      <section><h2>{t("Retention and revocation")}</h2><p>{t("Authentication credentials are retained only while the integration remains in use or until they expire or are revoked. Authorization may be revoked through the relevant LinkedIn account settings, and stored credentials may be removed from the private publishing environment. Content already published on LinkedIn may remain there until separately deleted.")}</p></section>
      <section><h2>{t("Website visitors")}</h2><p>{t("This public site does not require an account to read the professional portfolio. This policy does not claim collection of visitor data beyond information that may be processed by the site's hosting infrastructure as part of ordinary service delivery.")}</p></section>
      <section><h2>{t("Changes")}</h2><p>{t("This policy may be updated if the publishing workflow, data handling, or third-party integrations materially change. The revision date above identifies the current version.")}</p></section>
      <section><h2>{t("Contact")}</h2><p>{t("Questions about this policy or the publishing integration may be sent through the contact information available on Lucas Mateus's professional profiles.")}</p></section>
    </main>
  </body>
</html>
