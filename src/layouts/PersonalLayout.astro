---
import '../styles/personal.css';
interface Props { title: string; description: string; path?: string; lang?: string }
const { title, description, path = '', lang = 'pt-BR' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const canonical = new URL(`${home}${path}`, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#263641" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/identity.svg`} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <link rel="preload" href={`${base}/fonts/source-sans-3-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={`${base}/fonts/source-serif-4-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header wrap">
      <a class="identity" href={home} aria-label="Lucas Mateus · início"><span class="monogram" aria-hidden="true">lm.</span><span>Lucas Mateus</span></a>
      <nav aria-label="Navegação principal">
        <a href={`${home}#trabalho`}>Trabalho</a><a href={`${home}#criacoes`}>Criações</a><a href={`${home}#sobre`}>Sobre</a><a href={`${home}#contato`}>Contato</a>
      </nav>
      <a class="header-contact" href="https://www.linkedin.com/in/lucasmateus/">LinkedIn <span aria-hidden="true">↗</span></a>
    </header>
    <main id="conteudo" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-name" href={home}>Lucas Mateus</a><p>Trabalho, projetos e perguntas que sigo explorando.</p></div>
      <div class="footer-links"><a href={`${base}/portfolio/`}>Portfólio (em inglês)</a><a href="https://www.linkedin.com/in/lucasmateus/">LinkedIn ↗</a><a href={`${base}/privacy/`}>Privacidade</a></div>
      <small>São Paulo, Brasil · {new Date().getFullYear()}</small>
    </footer>
  </body>
</html>
