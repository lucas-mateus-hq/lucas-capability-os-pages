---
import CapabilityRegistry from '../components/CapabilityRegistry.astro';
import ImpactDemo from '../components/ImpactDemo.astro';
import CapabilityEvolutionLab from '../components/CapabilityEvolutionLab.astro';
import LiveCapabilityLab from '../components/LiveCapabilityLab.astro';
import telemetry from '../data/telemetry_source.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f4f0" />
    <title>Capability Lab / Capability OS — Independent Applied R&D</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="#home" aria-label="Capability OS home">
        <span class="brand-mark">LC</span>
        <span>Capability OS</span>
      </a>
      <nav aria-label="Primary">
        <a href="./portfolio/">Professional portfolio</a>
        <a href="#system">System</a>
        <a href="#impact-demo">In practice</a>
        <a href="#experiment">Blind test</a>
        <a href="#live-experiment">Live</a>
        <a href="#capabilities">Registry</a>
        <a href="#evidence">Evidence</a>
      </nav>
      <div class="operator-chip">
        <span>{telemetry.operator.label}</span>
        <img src="https://avatars.githubusercontent.com/u/322756565?v=4" alt="Lucas Mateus" loading="lazy" decoding="async" />
      </div>
    </header>

    <main id="home">
      <section class="hero" aria-labelledby="home-title">
        <div class="hero-kicker">Independent Applied R&D · Public system surface / 2026</div>
        <h1 id="home-title">Capability<br />Operating<br />System</h1>
        <div class="hero-bottom">
          <p>An independent project exploring how AI-assisted workflows, evidence, evaluation and reproducibility can help structure and validate complex work.</p>
          <dl>
            <div><dt>Surface</dt><dd>Sanitized public snapshot</dd></div>
            <div><dt>Source</dt><dd>Private canonical repository</dd></div>
            <div><dt>Authority</dt><dd>None · presentation only</dd></div>
          </dl>
        </div>
      </section>

      <section class="metric-band" aria-label="Current system metrics">
        <article>
          <span>01</span>
          <strong>{telemetry.summary.materialized_candidate_count}</strong>
          <p>Materialized capabilities</p>
          <code>evidence-backed · eval required</code>
        </article>
        <article>
          <span>02</span>
          <strong>{telemetry.summary.scaffold_unverified_count}</strong>
          <p>Scaffold / unverified</p>
          <code>no synthetic promotion</code>
        </article>
        <article>
          <span>03</span>
          <strong>{telemetry.summary.current_tier}</strong>
          <p>Verification depth</p>
          <code>active candidate</code>
        </article>
        <article>
          <span>04</span>
          <strong>{telemetry.operator.level}</strong>
          <p>Operator consolidation</p>
          <code>{telemetry.operator.label}</code>
        </article>
      </section>

      <section class="system-section" id="system">
        <header class="section-head">
          <span>01 / SYSTEM STATE</span>
          <h2>Operational by evidence,<br />not by appearance.</h2>
        </header>
        <div class="system-grid">
          <div class="system-copy">
            <p class="lead">Capability OS is an independent Applied R&D project by Lucas Mateus. The public Home Base exposes only high-level states that can be shown without publishing private contracts, execution receipts or credentials.</p>
            <p>This work is separate from Lucas's core professional career in Talent Acquisition and Recruiting Operations. Public publication cannot expand runtime authority; planning, authorization, execution and promotion remain separate concerns.</p>
          </div>
          <dl class="facts">
            <div><dt>Promotion rule</dt><dd>Green ≠ promotable</dd></div>
            <div><dt>Telemetry</dt><dd>{telemetry.mode}</dd></div>
            <div><dt>Schema</dt><dd>{telemetry.schema_version}</dd></div>
            <div><dt>Scope</dt><dd>{telemetry.source_scope}</dd></div>
          </dl>
        </div>
      </section>

      <ImpactDemo />
      <CapabilityEvolutionLab />
      <LiveCapabilityLab />

      <section id="capabilities" class="registry-section">
        <CapabilityRegistry />
      </section>

      <section class="evidence-section" id="evidence">
        <header class="section-head">
          <span>05 / EVIDENCE BOUNDARY</span>
          <h2>What is shown.<br />What stays private.</h2>
        </header>
        <div class="evidence-grid">
          <article>
            <span class="number">A</span>
            <h3>Public</h3>
            <p>Capability names, coarse maturity state, verification tier and sanitized publication metadata.</p>
          </article>
          <article>
            <span class="number">B</span>
            <h3>Private</h3>
            <p>Execution receipts, review packets, credentials, internal evidence, implementation contracts and source provenance.</p>
          </article>
          <article>
            <span class="number">C</span>
            <h3>Gated</h3>
            <p>Promotion requires evidence, independent evaluation and an explicit owner decision. Technical green alone does not promote capability.</p>
          </article>
        </div>
      </section>

      <section class="tier-section" id="progress">
        <div class="tier-copy">
          <span>06 / VERIFICATION DEPTH</span>
          <h2>Progress without synthetic scores.</h2>
        </div>
        <ol class="tier-list">
          {telemetry.tiers.map((tier, index) => (
            <li class:list={[tier.state === 'active_candidate' && 'is-current', tier.state === 'sealed' && 'is-done']}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{tier.id}</b>
              <em>{tier.label}</em>
              <small>{tier.state}</small>
            </li>
          ))}
        </ol>
      </section>

      <footer class="footer">
        <div>
          <span>Lucas Capability OS</span>
          <span>Public presentation layer · no runtime authority</span>
        </div>
        <div>
          <a href="./portfolio/">Professional portfolio</a>
          <a href="#home">Back to top ↑</a>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root{--ink:#11110f;--paper:#f4f4f0;--line:#c8c8c1;--muted:#6f6f69;--green:#17865b}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;background:var(--paper)}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .masthead{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:64px;padding:0 28px;border-bottom:1px solid #111;background:rgba(244,244,240,.94);backdrop-filter:blur(10px)}
  .brand{display:inline-flex;align-items:center;gap:10px;width:max-content;text-decoration:none;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
  .brand-mark{display:grid;place-items:center;width:28px;height:28px;border:1px solid #111;font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace}
  .masthead nav{display:flex;gap:20px}.masthead nav a{text-decoration:none;font-size:11px;color:#5f5f5a}.masthead nav a:hover{color:#111}
  .operator-chip{justify-self:end;display:flex;align-items:center;gap:10px;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#666661}
  .operator-chip img{width:30px;height:30px;border-radius:50%;object-fit:cover;filter:grayscale(1) contrast(1.1);transition:filter .35s ease,transform .35s ease;transform:translateZ(0)}
  .operator-chip:hover img{filter:grayscale(0);transform:translateZ(0) scale(1.04)}
  main{width:min(100%,1600px);margin:0 auto;padding:0 28px 42px}
  .hero{min-height:calc(100vh - 64px);display:grid;grid-template-rows:auto 1fr auto;padding:28px 0 36px;border-bottom:1px solid #111}
  .hero-kicker{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.06em;color:#686863}
  .hero h1{align-self:center;margin:34px 0;font-size:clamp(76px,13vw,210px);line-height:.78;letter-spacing:-.085em;font-weight:600;text-transform:uppercase}
  .hero-bottom{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:end}.hero-bottom>p{max-width:680px;margin:0;font-size:clamp(22px,2.6vw,38px);line-height:1.05;letter-spacing:-.035em}.hero-bottom dl{margin:0;display:grid}.hero-bottom dl div{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:10px 0;border-top:1px solid var(--line);font-size:11px}.hero-bottom dt{color:var(--muted)}.hero-bottom dd{margin:0;text-align:right}
  .metric-band{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #111}.metric-band article{min-height:200px;padding:18px 20px 22px 0;border-right:1px solid var(--line)}.metric-band article+article{padding-left:20px}.metric-band article:last-child{border-right:0}.metric-band span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#777772}.metric-band strong{display:block;margin-top:24px;font-size:clamp(54px,6vw,96px);line-height:.9;letter-spacing:-.06em;font-weight:500}.metric-band p{margin:18px 0 5px;font-size:12px}.metric-band code{font:500 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#797973}
  .system-section,.evidence-section,.tier-section{padding:86px 0;border-bottom:1px solid #111}
  .section-head{display:grid;grid-template-columns:220px 1fr;gap:38px;align-items:start;margin-bottom:58px}.section-head>span,.tier-copy>span{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c6c67;letter-spacing:.05em}.section-head h2,.tier-copy h2{margin:0;font-size:clamp(44px,6vw,88px);line-height:.94;letter-spacing:-.065em;font-weight:500}
  .system-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:80px;margin-left:258px}.system-copy{max-width:650px}.system-copy p{margin:0 0 20px;font-size:14px;line-height:1.65;color:#565651}.system-copy .lead{font-size:19px;line-height:1.45;color:#171715;letter-spacing:-.018em}
  .facts{margin:0}.facts div{display:grid;grid-template-columns:1fr auto;gap:24px;padding:13px 0;border-top:1px solid var(--line)}.facts dt{font-size:11px;color:#70706a}.facts dd{margin:0;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}
  .registry-section{padding:86px 0}
  .evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #111}.evidence-grid article{min-height:270px;padding:22px 28px 26px 0;border-right:1px solid var(--line)}.evidence-grid article+article{padding-left:28px}.evidence-grid article:last-child{border-right:0}.number{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c6c67}.evidence-grid h3{margin:54px 0 16px;font-size:30px;letter-spacing:-.04em}.evidence-grid p{max-width:400px;margin:0;font-size:13px;line-height:1.65;color:#5d5d58}
  .tier-section{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}.tier-copy h2{margin-top:18px;font-size:clamp(42px,5vw,72px)}.tier-list{list-style:none;margin:0;padding:0;border-top:1px solid #111}.tier-list li{display:grid;grid-template-columns:48px 56px 1fr auto;align-items:center;gap:18px;min-height:72px;border-bottom:1px solid var(--line)}.tier-list li span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#85857f}.tier-list li b{font-size:14px}.tier-list li em{font-style:normal;font-size:13px}.tier-list li small{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#75756f}.tier-list li.is-current b,.tier-list li.is-current small{color:var(--green)}.tier-list li.is-current{border-bottom-color:#9cc7b5}.tier-list li.is-done{color:#383835}
  .footer{display:flex;justify-content:space-between;gap:30px;padding:24px 0 0}.footer div{display:flex;gap:18px;flex-wrap:wrap}.footer span,.footer a{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.05em;color:#696963}.footer a{text-decoration:none}
  @media(max-width:980px){.masthead{grid-template-columns:1fr auto}.masthead nav{display:none}.hero{min-height:auto}.hero h1{margin:90px 0}.hero-bottom,.system-grid,.tier-section{grid-template-columns:1fr}.system-grid{margin-left:0}.metric-band{grid-template-columns:1fr 1fr}.metric-band article:nth-child(2){border-right:0}.metric-band article:nth-child(-n+2){border-bottom:1px solid var(--line)}.section-head{grid-template-columns:1fr;gap:18px}.evidence-grid{grid-template-columns:1fr}.evidence-grid article,.evidence-grid article+article{padding-left:0;border-right:0;border-bottom:1px solid var(--line)}.evidence-grid article:last-child{border-bottom:0}}
  @media(max-width:640px){.masthead{padding:0 18px}.operator-chip span{display:none}main{padding:0 18px 32px}.hero h1{font-size:clamp(64px,20vw,112px);line-height:.82}.hero-bottom{gap:36px}.hero-bottom dl div{grid-template-columns:90px 1fr}.metric-band{grid-template-columns:1fr}.metric-band article,.metric-band article+article{padding:18px 0;border-right:0;border-bottom:1px solid var(--line)}.system-section,.evidence-section,.tier-section,.registry-section{padding:58px 0}.tier-list li{grid-template-columns:36px 44px 1fr;gap:12px}.tier-list li small{grid-column:3}.footer{flex-direction:column}}
</style>