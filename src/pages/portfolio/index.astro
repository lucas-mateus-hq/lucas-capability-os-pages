---
const experience = [
  {
    company: 'Wellhub',
    role: 'Global Learning & Development Intern',
    period: 'Jun 2024 — Mar 2026',
    scope: 'Global stakeholder coordination, employee experience, operational support and learning technology, including Degreed rollout support.'
  },
  {
    company: 'Reckitt',
    role: 'Talent Acquisition Intern',
    period: 'Nov 2022 — Jul 2024',
    scope: 'Full-cycle recruiting within an assigned Brazil portfolio spanning Early Careers, operational and factory, commercial and junior corporate roles.'
  },
  {
    company: 'TikTok',
    role: 'Talent Acquisition Center (Global)',
    period: 'Apr 2022 — Sep 2022',
    scope: 'High-volume recruiting support for US and EMEA teams, including sourcing, screening, scheduling, candidate communication and KPI tracking.'
  },
  {
    company: 'RealLife English',
    role: 'Customer Success Agent',
    period: 'Jan 2021 — Jan 2022',
    scope: 'Remote customer support and cross-cultural communication with an international user base.'
  }
];

const capabilities = [
  'Talent Acquisition',
  'Recruiting Operations',
  'International Recruiting',
  'Talent Sourcing',
  'Candidate Experience',
  'Early Careers',
  'Cross-cultural Communication',
  'People / Learning Operations'
];

const appliedAiCapabilities = [
  'AI-assisted research & synthesis',
  'Human–AI workflow design',
  'Evaluation & experimentation',
  'Knowledge & state architecture',
  'AI orchestration literacy'
];

const education = [
  {
    program: 'Psychology',
    institution: 'Universidade Paulista',
    period: '2022 — Present'
  },
  {
    program: 'Law',
    institution: 'Universidade do Estado de Minas Gerais',
    period: '2018 — 2020'
  }
];

const languages = [
  'Portuguese — Native',
  'English — C1 / proficient',
  'Spanish — Basic to intermediate'
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lucas Mateus da Silva',
  url: 'https://github.com/lucas-mateus-hq',
  sameAs: ['https://www.linkedin.com/in/lucasmateus/'],
  homeLocation: { '@type': 'Place', name: 'São Paulo, Brazil' },
  knowsAbout: capabilities
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="description" content="Lucas Mateus — Talent Acquisition and Recruiting Operations professional with international recruiting, sourcing, candidate experience and People / Learning Operations experience." />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="canonical" href="https://lucas-mateus-hq.github.io/lucas-capability-os-pages/portfolio/" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Lucas Mateus — Talent Acquisition & Recruiting Operations" />
    <meta property="og:description" content="Professional portfolio covering Talent Acquisition, international recruiting, sourcing, candidate experience and independent Applied R&D." />
    <meta property="og:url" content="https://lucas-mateus-hq.github.io/lucas-capability-os-pages/portfolio/" />
    <title>Lucas Mateus — Talent Acquisition & Recruiting Operations</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <header class="topbar">
      <a class="identity" href="#top">Lucas Mateus</a>
      <nav aria-label="Professional portfolio navigation">
        <a href="#experience">Experience</a>
        <a href="#evidence">Evidence</a>
        <a href="#background">Background</a>
        <a href="#rnd">Applied R&D</a>
        <a href="https://www.linkedin.com/in/lucasmateus/" rel="me">LinkedIn</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">São Paulo, Brazil · Professional Portfolio</p>
        <h1 id="page-title">Talent Acquisition &<br />Recruiting Operations</h1>
        <p class="positioning">International recruiting, sourcing, candidate experience and operational coordination — with independent Applied R&D in AI-assisted workflows and systems thinking as a complementary differentiator.</p>
        <div class="actions">
          <a class="primary" href="https://www.linkedin.com/in/lucasmateus/">View LinkedIn</a>
          <a href="https://github.com/lucas-mateus-hq">GitHub profile</a>
        </div>
      </section>

      <section class="capabilities" aria-labelledby="capabilities-title">
        <div class="section-label" id="capabilities-title">Core capability areas</div>
        <div class="tag-grid">
          {capabilities.map((capability) => <span>{capability}</span>)}
        </div>
      </section>

      <section id="experience" class="section">
        <header class="section-head">
          <span>01</span>
          <div>
            <p>Professional experience</p>
            <h2>Recruiting first.<br />Operations across borders.</h2>
          </div>
        </header>
        <div class="experience-list">
          {experience.map((item) => (
            <article>
              <div class="company">{item.company}</div>
              <div>
                <h3>{item.role}</h3>
                <p>{item.scope}</p>
              </div>
              <div class="period">{item.period}</div>
            </article>
          ))}
        </div>
      </section>

      <section id="evidence" class="section evidence-section">
        <header class="section-head">
          <span>02</span>
          <div>
            <p>Selected evidence</p>
            <h2>Claims with context.</h2>
          </div>
        </header>
        <div class="evidence-grid">
          <article>
            <strong>International sourcing</strong>
            <p>For a Dublin search requiring Russian-language capability, used targeted Boolean sourcing and external communities; the role was filled in approximately one week.</p>
            <small>TikTok · targeted sourcing example</small>
          </article>
          <article>
            <strong>Candidate experience</strong>
            <p>Q1 2023 candidate survey, n=15: 100% gave the maximum rating for TA contact, recruitment-stage clarity and role/company information; 14 of 15 (93%) gave the maximum overall experience rating.</p>
            <small>Reckitt · candidate experience evidence</small>
          </article>
          <article>
            <strong>Early Careers support</strong>
            <p>Supported internship and apprentice recruiting and created a candidate preparation guide for a later recruitment stage.</p>
            <small>Reckitt · recruiting operations</small>
          </article>
        </div>
      </section>

      <section id="rnd" class="section rnd-section">
        <header class="section-head">
          <span>03</span>
          <div>
            <p>Applied research & development</p>
            <h2>Systems thinking as a differentiator.</h2>
          </div>
        </header>
        <div class="rnd-card">
          <div>
            <span class="badge">Independent Applied R&D</span>
            <h3>Capability Lab / Capability OS</h3>
            <p>I independently explore how AI-assisted workflows, evaluation, evidence, reproducibility and human-AI collaboration can improve how complex work is structured and validated.</p>
            <div class="mini-tag-grid">
              {appliedAiCapabilities.map((capability) => <span>{capability}</span>)}
            </div>
            <p class="boundary">This work is separate from my core professional career in Talent Acquisition and Recruiting Operations. The public R&D surface is intentionally limited; private implementation, credentials and internal evidence are not published.</p>
          </div>
          <a href="../">View Applied R&D snapshot →</a>
        </div>
      </section>

      <section id="background" class="section">
        <header class="section-head">
          <span>04</span>
          <div>
            <p>Education & languages</p>
            <h2>Background, stated precisely.</h2>
          </div>
        </header>
        <div class="profile-grid">
          <article class="profile-card">
            <strong>Education</strong>
            {education.map((item) => (
              <div class="profile-item">
                <h3>{item.program}</h3>
                <p>{item.institution} · {item.period}</p>

              </div>
            ))}
          </article>
          <article class="profile-card">
            <strong>Languages</strong>
            <ul>
              {languages.map((language) => <li>{language}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="section interests">
        <header class="section-head">
          <span>05</span>
          <div>
            <p>Current professional interests</p>
            <h2>Where this background fits.</h2>
          </div>
        </header>
        <p>Talent Acquisition · Recruiting Coordination · Recruiting Operations · Sourcing · Early Careers · International Recruiting · People / Learning Operations</p>
      </section>
    </main>

    <footer>
      <div>Lucas Mateus da Silva · São Paulo, Brazil</div>
      <div class="links"><a href="https://www.linkedin.com/in/lucasmateus/">LinkedIn</a><a href="https://github.com/lucas-mateus-hq">GitHub</a></div>
      <p>Canonical public professional portfolio. Platform profiles may contain abbreviated copies. Private professional records, credentials and internal project materials are not published here.</p>
    </footer>
  </body>
</html>

<style>
  :root{--ink:#121412;--paper:#f6f4ef;--line:#cbc8bf;--muted:#6e706b;--accent:#225744}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;background:var(--paper)}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .topbar{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:64px;padding:0 28px;border-bottom:1px solid var(--line);background:rgba(246,244,239,.94);backdrop-filter:blur(10px)}
  .identity{font-weight:700;text-decoration:none}.topbar nav{display:flex;gap:22px}.topbar nav a{font-size:12px;text-decoration:none;color:#555853}.topbar nav a:hover{color:#111}
  main,footer{width:min(100%,1480px);margin:0 auto;padding-left:28px;padding-right:28px}
  .hero{min-height:72vh;display:flex;flex-direction:column;justify-content:center;padding:80px 0;border-bottom:1px solid #111}
  .eyebrow,.section-label{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  h1{max-width:1200px;margin:18px 0 26px;font-size:clamp(56px,9vw,138px);line-height:.88;letter-spacing:-.075em;font-weight:600}
  .positioning{max-width:900px;margin:0;font-size:clamp(20px,2.3vw,34px);line-height:1.24;letter-spacing:-.035em;color:#343833}
  .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:34px}.actions a{display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border:1px solid #171917;text-decoration:none;font-size:12px}.actions .primary{background:#171917;color:#fff}
  .capabilities{padding:30px 0 60px;border-bottom:1px solid #111}.tag-grid{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.tag-grid span{padding:9px 12px;border:1px solid var(--line);font-size:11px;background:rgba(255,255,255,.35)}
  .section{padding:90px 0;border-bottom:1px solid #111}.section-head{display:grid;grid-template-columns:72px 1fr;gap:28px;margin-bottom:54px}.section-head>span{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.section-head p{margin:0 0 12px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.section-head h2{margin:0;font-size:clamp(42px,6vw,84px);line-height:.94;letter-spacing:-.06em;font-weight:500}
  .experience-list{border-top:1px solid #111}.experience-list article{display:grid;grid-template-columns:180px 1fr 180px;gap:28px;padding:24px 0;border-bottom:1px solid var(--line)}.experience-list article:last-child{border-bottom:0}.company{font-size:13px;font-weight:700}.experience-list h3{margin:0 0 8px;font-size:18px}.experience-list p{max-width:760px;margin:0;font-size:13px;line-height:1.6;color:#555852}.period{text-align:right;font:500 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}
  .evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #111}.evidence-grid article{min-height:300px;padding:26px 28px 28px 0;border-right:1px solid var(--line)}.evidence-grid article+article{padding-left:28px}.evidence-grid article:last-child{border-right:0}.evidence-grid strong{font-size:22px}.evidence-grid p{margin:72px 0 18px;font-size:14px;line-height:1.65}.evidence-grid small{font:500 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}
  .rnd-card{display:grid;grid-template-columns:1fr auto;gap:50px;align-items:end;padding:30px;border:1px solid #111;background:#e9eee9}.rnd-card>div{max-width:860px}.badge{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--accent)}.rnd-card h3{margin:16px 0 12px;font-size:32px}.rnd-card p{margin:0 0 12px;font-size:14px;line-height:1.65}.boundary{color:#555852}.rnd-card>a{font-size:12px;font-weight:700;text-decoration:none}
  .interests>p{max-width:1000px;margin:0 0 0 100px;font-size:clamp(22px,3vw,42px);line-height:1.3;letter-spacing:-.03em}
  footer{display:grid;grid-template-columns:1fr auto;gap:22px;padding-top:28px;padding-bottom:40px;font-size:11px;color:var(--muted)}footer .links{display:flex;gap:18px}footer p{grid-column:1/-1;max-width:900px;margin:0;font-size:10px;line-height:1.6}footer a{text-decoration:none}
  @media(max-width:820px){.topbar nav a:not(:last-child){display:none}.section-head{grid-template-columns:1fr;gap:12px}.experience-list article{grid-template-columns:1fr}.period{text-align:left}.profile-grid{grid-template-columns:1fr}.evidence-grid{grid-template-columns:1fr}.evidence-grid article,.evidence-grid article+article{min-height:0;padding:24px 0;border-right:0;border-bottom:1px solid var(--line)}.evidence-grid article:last-child{border-bottom:0}.evidence-grid p{margin:30px 0 14px}.rnd-card{grid-template-columns:1fr}.interests>p{margin-left:0}}
  @media(max-width:560px){.topbar,main,footer{padding-left:18px;padding-right:18px}.hero{min-height:auto;padding:72px 0}.section{padding:64px 0}h1{font-size:clamp(48px,17vw,76px)}footer{grid-template-columns:1fr}.links{grid-column:1}}
</style>
